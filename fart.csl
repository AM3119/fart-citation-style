<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0.2"
       class="in-text"
       default-locale="en-US">
  <info>
    <author><name>FART project contributors</name></author>
    <category citation-format="author-date"/>
    <id>http://www.zotero.org/styles/fart-citation-style</id>
    <link href="http://www.zotero.org/styles/fart-citation-style" rel="self"/>
    <rights license="https://creativecommons.org/licenses/by-sa/4.0/">FART project draft. Creative Commons Attribution-ShareAlike 4.0 International.</rights>
    <summary>Experimental multidisciplinary author-date style. FART redesign draft 0.14.</summary>
    <title>FART — Fancy Academic Reference Thingy</title>
    <updated>2026-11-19T17:30:00+01:00</updated>
  </info>

  <locale xml:lang="en-US">
    <terms>
      <term name="and">and</term>
      <term name="ad">AD</term>
      <term name="bc">BC</term>
      <term name="et-al">and friends</term>
      <term name="editor" form="short"><single>ed.</single><multiple>eds.</multiple></term>
      <term name="page" form="short"><single>p.</single><multiple>pp.</multiple></term>
    </terms>
  </locale>

  <macro name="author-short">
    <choose>
      <if type="personal_communication" variable="author" match="none">
        <text value="[Somebody who definitely exists]"/>
      </if>
      <else>
        <names variable="author" delimiter=", ">
          <name form="short" and="text" et-al-min="3" et-al-use-first="1"/>
          <substitute>
            <names variable="editor" delimiter=", ">
              <name form="short" and="text" et-al-min="3" et-al-use-first="1"/>
            </names>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>

  <macro name="author-long">
    <choose>
      <if type="personal_communication">
        <choose>
          <if variable="author">
            <names variable="author" delimiter=", ">
              <name and="text" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="3"/>
            </names>
          </if>
          <else><text value="[Somebody who definitely exists]"/></else>
        </choose>
      </if>
      <else>
        <names variable="author" delimiter=", ">
          <name and="text" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="3"/>
          <substitute>
            <names variable="editor" delimiter=", ">
              <name and="text" delimiter-precedes-last="never" et-al-min="4" et-al-use-first="3"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
            <text variable="title"/>
          </substitute>
        </names>
      </else>
    </choose>
  </macro>

  <macro name="issued-year">
    <group delimiter="">
      <text value="Published on:" font-weight="bold"/>
      <date variable="issued"><date-part name="year"/></date>
      <text variable="year-suffix"/>
    </group>
  </macro>

  <macro name="fart-status">
    <choose>
      <if variable="status"><text variable="status"/></if>
      <else-if type="thesis"><text value="[Some thesis of a sort]"/></else-if>
      <else-if type="song"><text value="[Yap]"/></else-if>
      <else-if type="post-weblog"><text value="[oh a blogger!]"/></else-if>
      <else-if type="speech"><text value="[Only a conference presentation tho]"/></else-if>
    </choose>
  </macro>  <macro name="citation-year">
    <group delimiter="">
      <date variable="issued"><date-part name="year"/></date>
      <text variable="year-suffix"/>
    </group>
  </macro>

  <macro name="title-quoted">
    <group delimiter=" ">
      <text value="Hereby dubbed:" font-weight="bold"/>
      <text variable="title" quotes="true" text-case="lowercase"/>
    </group>
  </macro>

  <macro name="journal-title">
    <group delimiter=" ">
      <text value="Brought to you by:" font-weight="bold"/>
      <text variable="container-title" font-style="italic"/>
    </group>
  </macro>

  <macro name="volume-issue-pages">
    <group delimiter="">
      <text variable="volume" font-weight="bold"/>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page" prefix=": "/>
      <text variable="number" prefix=": "/>
    </group>
  </macro>

  <macro name="identifiers">
    <choose>
      <if variable="PMID PMCID">
        <group delimiter=" ">
          <text value="For the quacks:" font-weight="bold"/>
          <group delimiter="; ">
            <text variable="PMID" prefix="PMID "/>
            <text variable="PMCID" prefix="PMCID "/>
          </group>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="doi-or-url">
    <choose>
      <if variable="DOI">
        <group delimiter=" ">
          <text value="Fancy identifier:" font-weight="bold"/>
          <text variable="DOI" prefix="https://doi.org/"/>
        </group>
      </if>
      <else-if variable="URL"><text variable="URL"/></else-if>
      <else><text value="I guess."/></else>
    </choose>
  </macro>

  <macro name="access-date">
    <choose>
      <if variable="accessed">
        <group delimiter=" ">
          <text value="Last time I checked:"/>
          <date variable="accessed">
            <date-part name="month" form="long"/>
            <date-part name="day" prefix=" "/>
            <date-part name="year" prefix=", "/>
          </date>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="publisher-place">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <group delimiter=" ">
        <text value="Brought to you by:" font-weight="bold"/>
        <text variable="publisher"/>
      </group>
    </group>
  </macro>

  <citation disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter=" and also ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="citation-year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true">
    <sort><key variable="citation-number"/></sort>
    <layout suffix=".">
      <group delimiter=" ">
        <text value="Formulated by:" font-weight="bold"/>
        <text macro="author-long"/>
        <text macro="issued-year"/>
        <text macro="fart-status"/>
        <choose>
          <if type="article-journal review">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text macro="journal-title"/>
              <text macro="volume-issue-pages"/>
            </group>
          </if>
          <else-if type="software">
            <group delimiter=" ">
              <group delimiter=" "><text value="Hereby dubbed:" font-weight="bold"/><text variable="title"/></group>
              <text variable="version" prefix="Version "/>
              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="publisher"/></group>
              <text variable="publisher-place"/>
              <text variable="genre"/>
            </group>
          </else-if>
          <else-if type="dataset">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text value="[Dataset]"/>
              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="publisher"/></group>
              <text variable="version" prefix="Version "/>
              <text variable="genre"/>
            </group>
          </else-if>
          <else-if type="personal_communication">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text variable="medium"/>
              <names variable="recipient"><name and="text"/></names>
              <text variable="genre"/>
            </group>
          </else-if>
          <else-if type="paper-conference">
            <group delimiter=" ">
              <text macro="title-quoted"/>

              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="event-title" font-style="italic"/></group>
              <text variable="publisher-place"/>
              <text variable="page" prefix="pp. "/>
            </group>
          </else-if>
          <else-if type="interview">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text variable="medium"/>
              <names variable="interviewer"><name and="text"/></names>
              <text variable="publisher"/>
            </group>
          </else-if>
          <else-if type="post-weblog">
            <group delimiter=" ">
              <text macro="title-quoted"/>

              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" font-style="italic"/></group>
              <text macro="access-date"/>
            </group>
          </else-if>
          <else-if type="standard regulation">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text variable="number" prefix="Standard no. "/>
              <text variable="authority"/>
              <text macro="publisher-place"/>
            </group>
          </else-if>
          <else-if type="report document">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text variable="genre"/>
              <text variable="number" prefix="Report no. "/>
              <text macro="publisher-place"/>
            </group>
          </else-if>
          <else-if type="review-book">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text variable="reviewed-title" prefix="Review of "/>
              <text macro="journal-title"/>
              <text macro="volume-issue-pages"/>
            </group>
          </else-if>
          <else-if type="book">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text variable="edition" suffix=" ed."/>
              <text macro="publisher-place"/>
              <text variable="ISBN" prefix="ISBN "/>
            </group>
          </else-if>
          <else-if type="chapter">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <group delimiter=" ">
                <text value="In:"/>
                <names variable="editor" delimiter=", ">
                  <name and="text" name-as-sort-order="all" initialize="true" initialize-with=""/>
                  <label form="short" prefix=" (" suffix=")"/>
                </names>
                <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" quotes="true" text-case="lowercase"/></group>
              </group>
              <text macro="publisher-place"/>
              <text variable="page" prefix="pp. "/>
            </group>
          </else-if>
          <else-if type="patent">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text variable="number" prefix="Patent no. "/>
              <text variable="authority"/>
            </group>
          </else-if>
          <else-if type="legal_case">
            <group delimiter=" ">
              <group delimiter=" "><text value="Hereby dubbed:" font-weight="bold"/><text variable="title" font-style="italic" text-case="lowercase"/></group>
              <text variable="authority"/>
              <text variable="number"/>
              <text variable="page"/>
            </group>
          </else-if>
          <else-if type="legislation bill">
            <group delimiter=" ">
              <group delimiter=" "><text value="Hereby dubbed:" font-weight="bold"/><text variable="title" font-style="italic" text-case="lowercase"/></group>
              <text variable="authority"/>
              <text variable="number"/>
            </group>
          </else-if>
          <else-if type="thesis">
            <group delimiter=" ">
              <text macro="title-quoted"/>

              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </else-if>
          <else-if type="manuscript">
            <group delimiter=" ">
              <text macro="title-quoted"/>

              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </else-if>
          <else-if type="webpage">
            <group delimiter=" ">
              <text macro="title-quoted"/>

              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" font-style="italic"/></group>
              <text macro="access-date"/>
            </group>
          </else-if>
          <else-if type="post">
            <group delimiter=" ">
              <text macro="title-quoted"/>

              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" font-style="italic"/></group>
              <text macro="access-date"/>
            </group>
          </else-if>
          <else-if type="article-magazine">
            <group delimiter=" ">
              <text macro="title-quoted"/>

              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" font-style="italic"/></group>
              <text macro="access-date"/>
            </group>
          </else-if>
          <else-if type="article-newspaper">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" font-style="italic"/></group>
              <text macro="access-date"/>
            </group>
          </else-if>
          <else-if type="broadcast">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <names variable="author" delimiter=", ">
                <name and="text" initialize="true" initialize-with=""/>
              </names>
              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" font-style="italic"/></group>
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </else-if>
          <else-if type="song">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" font-style="italic"/></group>
              <text variable="number" prefix="Episode "/>
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </else-if>
          <else-if type="speech">
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <text variable="genre"/>
              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="event-title" font-style="italic"/></group>
              <text variable="event-place"/>
              <text variable="publisher"/>
              <text macro="access-date"/>
            </group>
          </else-if>
          <else-if type="motion_picture">
            <group delimiter=" ">
              <text macro="title-quoted"/>

              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </else-if>
          <else>
            <group delimiter=" ">
              <text macro="title-quoted"/>
              <group delimiter=" "><text value="Brought to you by:" font-weight="bold"/><text variable="container-title" font-style="italic"/></group>
              <text variable="publisher"/>
              <text variable="publisher-place"/>
            </group>
          </else>
        </choose>
        <text macro="identifiers"/>
        <text macro="doi-or-url"/>
      </group>
    </layout>
  </bibliography>
</style>
